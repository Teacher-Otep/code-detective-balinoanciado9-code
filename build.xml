        import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

// =========================================================================
// SECTION 1: THE DATA MODULE (Manages product profiles)
// =========================================================================
class MenuItem {
    private int id;
    private String name;
    private double price;

    public MenuItem(int id, String name, double price) {
        this.id = id;
        this.name = name;
        this.price = price;
    }

    public int getId() { return id; }
    public String getName() { return name; }
    public double getPrice() { return price; }
}

// =========================================================================
// SECTION 2: THE CART & MATH MODULE (Manages items and calculations)
// =========================================================================
class OrderCart {
    public static class CartEntry {
        private MenuItem item;
        private int quantity;

        public CartEntry(MenuItem item, int quantity) {
            this.item = item;
            this.quantity = quantity;
        }

        public MenuItem getItem() { return item; }
        public int getQuantity() { return quantity; }
        public void setQuantity(int quantity) { this.quantity = quantity; }
        public double getTotalPrice() { return item.getPrice() * quantity; }
    }

    private List<CartEntry> entries = new ArrayList<>();

    public void addItem(MenuItem item, int quantity) {
        for (CartEntry entry : entries) {
            if (entry.getItem().getId() == item.getId()) {
                entry.setQuantity(entry.getQuantity() + quantity);
                return;
            }
        }
        entries.add(new CartEntry(item, quantity));
    }

    public List<CartEntry> getEntries() { return entries; }
    public boolean isEmpty() { return entries.isEmpty(); }

    public double getGrandTotal() {
        double total = 0.0;
        for (CartEntry entry : entries) {
            total += entry.getTotalPrice();
        }
        return total;
    }
}

// =========================================================================
// SECTION 3: THE MAIN INTERFACE CONTROLLER (Manages menus and actions)
// =========================================================================
public class CoffeeShopApp {
    private List<MenuItem> menu = new ArrayList<>();
    private OrderCart activeCart = new OrderCart();
    private Scanner scanner = new Scanner(System.in);

    public CoffeeShopApp() {
        menu.add(new MenuItem(1, "Espresso", 90.00));
        menu.add(new MenuItem(2, "Americano", 100.00));
        menu.add(new MenuItem(3, "Café Latte", 120.00));
        menu.add(new MenuItem(4, "Cappuccino", 125.00));
        menu.add(new MenuItem(5, "Mocha Latte", 135.00));
    }

    public void displayMenu() {
        System.out.println("\n=========================================");
        System.out.println("            DIGITAL MENU                 ");
        System.out.println("=========================================");
        for (MenuItem item : menu) {
            System.out.printf("[%d] %-18s - ₱%.2f\n", item.getId(), item.getName(), item.getPrice());
        }
        System.out.println("-----------------------------------------");
        System.out.println("[9] Proceed to Checkout");
        System.out.println("[0] Cancel & Exit");
    }

    public void startService() {
        while (true) {
            displayMenu();
            System.out.print("\nSelect an option or item ID: ");
            int choice = readIntInput();

            if (choice == 0) {
                System.out.println("Order cancelled. Goodbye!");
                break;
            } else if (choice == 9) {
                if (activeCart.isEmpty()) {
                    System.out.println("Your cart is empty! Add items before checking out.");
                } else {
                    checkoutWorkflow();
                    break;
                }
            } else {
                MenuItem selectedItem = findItem(choice);
                if (selectedItem == null) {
                    System.out.println("Invalid Option! Please try again.");
                    continue;
                }
                System.out.print("Enter quantity for " + selectedItem.getName() + ": ");
                int quantity = readIntInput();
                if (quantity <= 0) {
                    System.out.println("Quantity must be greater than 0.");
                    continue;
                }
                activeCart.addItem(selectedItem, quantity);
                System.out.printf("Added %dx %s to your cart.\n", quantity, selectedItem.getName());
            }
        }
    }

    private MenuItem findItem(int id) {
        for (MenuItem item : menu) {
            if (item.getId() == id) return item;
        }
        return null;
    }

    private void checkoutWorkflow() {
        double totalToPay = activeCart.getGrandTotal();
        System.out.println("\n=========================================");
        System.out.println("             BILL DETAILS                ");
        System.out.println("=========================================");
        System.out.printf("GRAND TOTAL DUE:               ₱%.2f\n", totalToPay);
        System.out.println("=========================================");

        double cashReceived = 0.0;
        while (true) {
            System.out.print("Enter Cash Tendered Amount: ₱");
            if (scanner.hasNextDouble()) {
                cashReceived = scanner.nextDouble();
                if (cashReceived >= totalToPay) {
                    break;
                } else {
                    System.out.printf("Inadequate Cash! You still owe ₱%.2f more.\n", (totalToPay - cashReceived));
                }
            } else {
                System.out.println("Invalid cash entry. Please enter a proper amount.");
                scanner.next();
            }
        }
        printFinalReceipt(cashReceived);
    }

    private void printFinalReceipt(double cash) {
        System.out.println("\n=========================================");
        System.out.println("             OFFICIAL RECEIPT            ");
        System.out.println("=========================================");
        System.out.printf("%-18s %-6s %-10s\n", "Item", "Qty", "Total");
        System.out.println("-----------------------------------------");

        for (OrderCart.CartEntry entry : activeCart.getEntries()) {
            System.out.printf("%-18s x%-5d ₱%.2f\n", 
                entry.getItem().getName(), entry.getQuantity(), entry.getTotalPrice());
        }

        System.out.println("-----------------------------------------");
        System.out.printf("GRAND TOTAL:                    ₱%.2f\n", activeCart.getGrandTotal());
        System.out.println("-----------------------------------------");
        System.out.printf("Cash Tendered:                  ₱%.2f\n", cash);
        System.out.printf("Change Tendered:                ₱%.2f\n", (cash - activeCart.getGrandTotal()));
        System.out.println("=========================================");
        System.out.println("       Thank you for your order!         ");
        System.out.println("=========================================");
    }

    private int readIntInput() {
        while (!scanner.hasNextInt()) {
            System.out.println("Invalid input numeric type expected. Try again.");
            scanner.next();
        }
        return scanner.nextInt();
    }

    public static class Main {
        public static void main(String[] args) {
            CoffeeShopApp shop = new CoffeeShopApp();
            shop.startService();
        }
    }
}
